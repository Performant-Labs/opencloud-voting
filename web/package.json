{
  "name": "web-app-feature-voting",
  "version": "1.0.0",
  "description": "Feature voting app for OpenCloud — submit ideas and vote for the features you want most.",
  "license": "AGPL-3.0",
  "author": "Performant Labs",
  "private": true,
  "homepage": "https://github.com/Performant-Labs/opencloud-voting",
  "type": "module",
  "scripts": {
    "build": "pnpm vite build",
    "build:w": "pnpm vite build --watch --mode development",
    "check:types": "vue-tsc --noEmit",
    "lint": "eslint 'src/**/*.{js,ts,vue}' --color",
    "format:check": "prettier . --check",
    "format:write": "prettier . --write",
    "test:unit": "NODE_OPTIONS=--unhandled-rejections=throw vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@opencloud-eu/eslint-config": "^6.0.0",
    "@opencloud-eu/extension-sdk": "^6.0.0",
    "@opencloud-eu/prettier-config": "^6.0.0",
    "@opencloud-eu/tsconfig": "^6.0.0",
    "@opencloud-eu/web-client": "^6.0.0",
    "@opencloud-eu/web-pkg": "^6.0.0",
    "@playwright/test": "^1.58.2",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.0",
    "happy-dom": "^20.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "vue": "^3.5.13",
    "vue-router": "^5.0.0",
    "vue-tsc": "^3.0.0",
    "vue3-gettext": "^4.0.0-beta.1"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}